{
  "name": "@waddle/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@waddle/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "@waddle/source": "./src/auth-entry.ts",
      "types": "./dist/auth-entry.d.ts",
      "import": "./dist/auth-entry.js",
      "default": "./dist/auth-entry.js"
    }
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "better-auth": "^1.7.12"
  },
  "nx": {
    "targets": {
      "generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec drizzle-kit generate",
          "cwd": "packages/db"
        }
      },
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec drizzle-kit migrate",
          "cwd": "packages/db"
        }
      },
      "push": {
        "dependsOn": [],
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec drizzle-kit push",
          "cwd": "packages/db"
        }
      },
      "seed": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun packages/db/src/bin/seed.ts"
        }
      },
      "studio": {
        "executor": "nx:run-commands",
        "options": {
          "command": "pnpm exec drizzle-kit studio",
          "cwd": "packages/db"
        }
      }
    }
  }
}
