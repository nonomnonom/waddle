    "@nx/jest": "24.0.1",
    "@nx/js": "24.0.1",
    "@nx/nest": "24.0.1",
    "@nx/node": "24.0.1",
    "@nx/react": "24.0.1",
    "@nx/vite": "24.0.1",
    "@nx/web": "24.0.1",
    "@nx/webpack": "24.0.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
