{
  "name": "@waddle/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev:api": "nx run-many -t build -p @waddle/protocol,@waddle/db,@waddle/engine && bun --watch packages/apps/api/dist/main.js",
    "dev:web": "nx serve web",
    "db:up": "docker compose up -d",
    "db:migrate": "nx run @waddle/db:migrate",
    "db:seed": "nx run @waddle/db:seed",
    "db:generate": "nx run @waddle/db:generate",
    "smoke": "bun scripts/smoke-api.ts",
    "check:query": "bun scripts/check-http-query.ts",
    "verify": "nx run-many -t typecheck && nx run-many -t test && nx run-many -t build",
    "coverage:id-en": "bun scripts/measure-coverage.ts"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
