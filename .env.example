# Salin ke .env lalu isi. Nilai di bawah aman untuk development lokal.

# --- api (apps/api) ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://waddle:waddle@localhost:5433/waddle
# minimal 32 karakter; JANGAN pakai nilai ini di production
BETTER_AUTH_SECRET=dev-only-secret-change-me-please-32chars
BETTER_AUTH_URL=http://localhost:3000
# origin yang diizinkan untuk CORS *dan* untuk pemeriksaan origin better-auth;
# dua-duanya harus sama atau sign-in browser kena 403
# (4200 = vite dev, 4300 = vite preview)
CORS_ORIGINS=http://localhost:4200,http://localhost:4300
# lane remote LLM dimatikan secara default: terjemahan id->en memakai kamus lokal
AI_REMOTE_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEY=
APP_CHANNEL=dev

# --- web (apps/web) ---
VITE_API_URL=http://localhost:3000
